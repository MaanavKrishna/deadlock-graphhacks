# Default: real embedded FalkorDB, persisted in .data/graph. No key required.
PORT=3000
HOST=127.0.0.1
DATA_DIR=.data/graph
# Optional Docker / cloud database (rediss:// for TLS).
# FALKORDB_URL=redis://127.0.0.1:6379
# FALKORDB_GRAPH=deadlock
# Optional model advisor. Policies still determine all terms and commitments.
# MODEL_API_KEY=your-key
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=your-provider-model-id
