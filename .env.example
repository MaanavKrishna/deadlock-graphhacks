# Default: real embedded FalkorDB, persisted in .data/graph. No key required.
PORT=3000
HOST=127.0.0.1
DATA_DIR=.data/graph
# Optional Docker / cloud database (rediss:// for TLS).
# FALKORDB_URL=redis://127.0.0.1:6379
# FALKORDB_GRAPH=deadlock
# Optional live model representatives. Must support Chat Completions function tools.
# Configuration is reread on each negotiation; use Refresh configuration in the UI.
# MODEL_API_KEY=your-anthropic-key
# MODEL_BASE_URL=https://api.anthropic.com/v1
# MODEL_NAME=claude-haiku-5-5
